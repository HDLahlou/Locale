{
  "$defs": {
    "Credential": {
      "description": "Account credential: v1.<base64url(payload JSON)>.<base64url(Ed25519 signature)>.",
      "pattern": "^v1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{86}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`POST /v1/credential/refresh` response.",
  "properties": {
    "credential": {
      "$ref": "#/$defs/Credential",
      "description": "A fresh credential."
    }
  },
  "required": [
    "credential"
  ],
  "title": "CredentialRefreshResponse",
  "type": "object"
}
