{
  "$defs": {
    "DevicePublicKey": {
      "description": "Ed25519 public key, base64url without padding.",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`POST /v1/credential/refresh` request.",
  "properties": {
    "device_pubkey": {
      "$ref": "#/$defs/DevicePublicKey",
      "description": "The device's public key; must match the refresh token's."
    },
    "refresh_token": {
      "description": "Refresh token.",
      "type": "string"
    }
  },
  "required": [
    "refresh_token",
    "device_pubkey"
  ],
  "title": "CredentialRefreshRequest",
  "type": "object"
}
