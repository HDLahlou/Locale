{
  "$defs": {
    "CredentialRole": {
      "description": "Closed enum: receivers reject values they do not know.",
      "enum": [
        "verified"
      ],
      "type": "string"
    },
    "DevicePublicKey": {
      "description": "Ed25519 public key, base64url without padding.",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The signed payload of a credential.",
  "properties": {
    "account_id": {
      "description": "Account ID.",
      "type": "string"
    },
    "device_pubkey": {
      "$ref": "#/$defs/DevicePublicKey",
      "description": "The device key that must sign the join proof."
    },
    "display_name": {
      "description": "Display name.",
      "type": "string"
    },
    "expires_at": {
      "description": "Expiry.",
      "format": "int64",
      "type": "integer"
    },
    "issued_at": {
      "description": "Issue time.",
      "format": "int64",
      "type": "integer"
    },
    "kid": {
      "description": "ID of the service signing key, looked up in the host's key list.",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/CredentialRole",
      "description": "Always `verified`."
    }
  },
  "required": [
    "kid",
    "account_id",
    "display_name",
    "role",
    "device_pubkey",
    "issued_at",
    "expires_at"
  ],
  "title": "CredentialPayload",
  "type": "object"
}
