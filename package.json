{
  "name": "locale-workspace",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "format": "prettier --write \"apps/*/{src,e2e}/**/*.{ts,tsx,css,html}\" \"apps/*/*.{ts,json,html}\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"apps/*/{src,e2e}/**/*.{ts,tsx,css,html}\" \"apps/*/*.{ts,json,html}\" \"*.{json,mjs}\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
